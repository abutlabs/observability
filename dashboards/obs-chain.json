 "panels": [
  {
   "type": "text",
   "title": "",
   "transparent": true,
   "options": {
    "mode": "markdown",
    "content": "**Is the net one chain that keeps growing and finalizing, on every node?** Each line is one node: its best and finalized slots should climb together, finality lag should stay under one epoch (12 slots on tiny), and head agreement should read one head. Any client works: the standard `jam_*` series come from the node's own metrics, the JIP-2 exporter or the JIP-3 receiver."
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   }
  },
  {
   "type": "stat",
   "title": "Nodes stopped reporting (15 min) \u00b7 PASS = 0",
   "description": "Nodes that reported a best block in the last 15 minutes but report none now.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "count(max by (node) (last_over_time(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}[15m]))) - (count(max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"})) or vector(0))",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1e-09
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "area",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 5,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "One head \u00b7 PASS = all nodes on one block (\u2264 3 slots behind)",
   "description": "jam_net_one_head (the JIP-2 exporter compares block hashes): every node up, one block at the common slot, none more than 3 slots behind. Without it, the spread of best slots stands in.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "min(jam_net_one_head{net=\"$net\",run_id=\"$run_id\"}) or on() ((max(max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"})) - min(max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"}))) <= bool 3)",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "FAIL",
         "color": "red"
        },
        "1": {
         "text": "PASS",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "graphMode": "area",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 3,
   "gridPos": {
    "x": 5,
    "y": 3,
    "w": 5,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Finality lag, worst node \u00b7 PASS \u2264 12 slots",
   "description": "Best slot minus finalized slot on the node that lags most.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"}) - (max by (node, client) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"}) > 0))",
     "refId": "A",
     "range": true,
     "instant": false
    }
