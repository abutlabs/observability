    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 4,
   "gridPos": {
    "x": 10,
    "y": 3,
    "w": 5,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Finalized in 5 min, slowest node \u00b7 PASS > 0 slots",
   "description": "How far the slowest node's finalized block moved in the last 5 minutes. 0 = finality stalled on some node.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "last_over_time((min((max_over_time((max by (node, client) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"}))[5m:15s]) - min_over_time((max by (node, client) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"}) > 0)[5m:15s])) or (max by (node, client) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"}) * 0)))[$__range:$__interval] @ $at)",
     "refId": "A",
     "range": false,
