   }
  },
  {
   "type": "stat",
   "title": "Finality conflicts \u00b7 PASS = 0",
   "description": "Finalized slots seen with two different hashes (a safety failure; needs a collector that compares hashes, such as the JIP-2 exporter).",
   "datasource": {
