   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "min((max_over_time((max by (node, client) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"}))[5m:15s]) - min_over_time((max by (node, client) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"}) > 0)[5m:15s])) or (max by (node, client) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"}) * 0))",
     "refId": "A",
     "range": true,
