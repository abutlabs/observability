  {
   "type": "timeseries",
   "title": "Head agreement",
   "description": "The JIP-2 exporter compares block hashes at the common slot across every node; the spread of best slots works from any path.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "min(jam_net_heads{net=\"$net\",run_id=\"$run_id\"})",
     "legendFormat": "distinct heads at the common slot (1 = one head)",
     "refId": "A",
     "range": true
    },
    {
     "expr": "min(jam_net_final_heads{net=\"$net\",run_id=\"$run_id\"})",
     "legendFormat": "distinct finalized blocks (1 = agree)",
     "refId": "B",
     "range": true
    },
    {
     "expr": "max(max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"})) - min(max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"}))",
     "legendFormat": "best-slot spread",
     "refId": "C",
     "range": true
