{
 "uid": "obs-logs",
 "title": "Logs",
 "tags": [
  "obs"
 ],
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "templating": {
  "list": [
   {
    "name": "net",
    "label": "net",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": "label_values(net)",
    "definition": "label_values(net)",
    "refresh": 2,
    "sort": 1,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 0
   },
   {
    "name": "run_id",
    "label": "run_id",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": "label_values({net=\"$net\"}, run_id)",
    "definition": "label_values({net=\"$net\"}, run_id)",
    "refresh": 2,
    "sort": 2,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 0
   },
   {
    "name": "node",
    "label": "node",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": "label_values({net=\"$net\", run_id=\"$run_id\"}, node)",
    "definition": "label_values({net=\"$net\", run_id=\"$run_id\"}, node)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "current": {},
    "options": [],
    "hide": 0,
    "allValue": ".+"
   },
   {
    "name": "search",
    "label": "search (regex)",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    },
    "hide": 0
   },
   {
    "name": "at",
    "label": "at",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "query_result(clamp_max(max(obs_run_end_timestamp_seconds{net=\"$net\",run_id=\"$run_id\"}), ${__to:date:seconds}) or vector(${__to:date:seconds}))",
    "definition": "query_result(clamp_max(max(obs_run_end_timestamp_seconds{net=\"$net\",run_id=\"$run_id\"}), ${__to:date:seconds}) or vector(${__to:date:seconds}))",
    "regex": "/\\}\\s+(\\S+)\\s/",
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 2
   },
   {
    "name": "run_from",
    "label": "run_from",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "query_result(max by (link_from) (obs_run_info{net=\"$net\",run_id=\"$run_id\"}))",
    "definition": "query_result(max by (link_from) (obs_run_info{net=\"$net\",run_id=\"$run_id\"}))",
    "regex": "/link_from=\"([^\"]+)\"/",
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 2
   },
   {
    "name": "run_to",
    "label": "run_to",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "query_result(max by (link_to) (obs_run_info{net=\"$net\",run_id=\"$run_id\"}))",
    "definition": "query_result(max by (link_to) (obs_run_info{net=\"$net\",run_id=\"$run_id\"}))",
    "regex": "/link_to=\"([^\"]+)\"/",
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 2
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "name": "Annotations & Alerts",
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "type": "dashboard",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    }
   },
   {
    "name": "run events",
    "enable": true,
    "hide": false,
    "iconColor": "#5794F2",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "target": {
     "type": "tags",
     "tags": [
      "$run_id",
      "event"
     ],
     "matchAny": false,
     "limit": 500
    }
   },
   {
    "name": "PASS",
    "enable": true,
    "hide": false,
    "iconColor": "green",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "target": {
     "type": "tags",
     "tags": [
      "$run_id",
      "pass"
     ],
     "matchAny": false,
     "limit": 500
    }
   },
   {
    "name": "FAIL",
    "enable": true,
    "hide": false,
    "iconColor": "red",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "target": {
     "type": "tags",
     "tags": [
      "$run_id",
      "fail"
     ],
     "matchAny": false,
     "limit": 500
    }
   },
   {
    "name": "lifecycle",
    "enable": true,
    "hide": false,
    "iconColor": "#B877D9",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "expr": "{source=\"lifecycle\", net=\"$net\", run_id=\"$run_id\"} | json | event=~\"run_begin|run_end|start|restart|die\" | during_run!=\"true\" or reason!~\"killed|oom|crashed\"",
    "target": {
     "expr": "{source=\"lifecycle\", net=\"$net\", run_id=\"$run_id\"} | json | event=~\"run_begin|run_end|start|restart|die\" | during_run!=\"true\" or reason!~\"killed|oom|crashed\"",
     "refId": "Anno",
     "queryType": "range"
    },
    "instant": false,
    "titleFormat": "{{node}} {{event}}",
    "textFormat": "{{msg}}",
    "tagKeys": "node,event,reason"
   },
   {
    "name": "node stopped during the run",
    "enable": true,
    "hide": false,
    "iconColor": "red",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "expr": "{source=\"lifecycle\", net=\"$net\", run_id=\"$run_id\"} | json | event=\"die\" | during_run=\"true\" | reason=~\"killed|oom|crashed\"",
    "target": {
     "expr": "{source=\"lifecycle\", net=\"$net\", run_id=\"$run_id\"} | json | event=\"die\" | during_run=\"true\" | reason=~\"killed|oom|crashed\"",
     "refId": "Anno",
     "queryType": "range"
    },
    "instant": false,
    "titleFormat": "{{node}} {{event}}",
    "textFormat": "{{msg}}",
    "tagKeys": "node,event,reason"
   }
  ]
 },
 "links": [
  {
   "type": "link",
   "title": "whole run",
   "icon": "dashboard",
   "includeVars": true,
   "keepTime": false,
   "targetBlank": false,
   "tooltip": "Set the time range to this run's start \u2192 end (1 min either side)",
   "url": "/d/obs-logs?from=${run_from}&to=${run_to}"
  },
  {
   "type": "dashboards",
   "tags": [
    "obs"
   ],
   "asDropdown": false,
   "includeVars": true,
   "keepTime": true,
   "title": "obs"
  }
 ],
 "panels": [
  {
   "type": "text",
   "title": "",
   "transparent": true,
   "options": {
    "mode": "markdown",
    "content": "**What did the nodes say?** Every labelled container's output (`source=\"docker\"`), every JIP-3 event a node pushed (`source=\"jip3\"`, one JSON object per event) and the containers' lifecycle (`source=\"lifecycle\"`: start, stop, die with exit code), for the run and nodes picked above. Narrow it with *search* (a regex)."
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 2
   }
  },
  {
   "type": "timeseries",
   "title": "Log lines per node",
   "description": "Lines per interval, by node.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum by (node) (count_over_time({net=\"$net\", run_id=\"$run_id\", node=~\"$node\"} |~ \"$search\" [$__auto]))",
     "legendFormat": "{{node}}",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0,
     "links": [
      {
       "title": "Node detail: ${__field.labels.node}",
       "targetBlank": false,
       "url": "/d/obs-node?orgId=1&var-net=${net}&var-run_id=${run_id}&var-node=${__field.labels.node}&${__url_time_range}"
      },
      {
       "title": "Logs of ${__field.labels.node} up to here (Explore)",
       "targetBlank": true,
       "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22loki%22%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__value.time}%22%7D%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bnet%3D%5C%22$net%5C%22%2Crun_id%3D%5C%22$run_id%5C%22%2Cnode%3D%5C%22${__field.labels.node}%5C%22%7D%22%7D%5D%7D%7D"
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 2,
    "w": 12,
    "h": 7
   }
  },
  {
   "type": "timeseries",
   "title": "JIP-3 events by type",
   "description": "Telemetry events the nodes pushed, by event type.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum by (event) (count_over_time({net=\"$net\", run_id=\"$run_id\", node=~\"$node\", source=\"jip3\"} | json event=\"event\" [$__auto]))",
     "legendFormat": "{{event}}",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 3,
   "gridPos": {
    "x": 12,
    "y": 2,
    "w": 12,
    "h": 7
   }
  },
  {
   "type": "logs",
   "title": "Lines",
   "description": "Newest first. Expand a line for its labels.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{net=\"$net\", run_id=\"$run_id\", node=~\"$node\"} |~ \"$search\"",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false,
    "showLabels": false,
    "showCommonLabels": false
   },
   "id": 4,
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 18
   }
  }
 ]
}
