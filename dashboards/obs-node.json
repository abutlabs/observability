{
 "uid": "obs-node",
 "title": "Node detail",
 "tags": [
  "obs"
 ],
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "templating": {
  "list": [
   {
    "name": "net",
    "label": "net",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values({__name__=~\"up|jam_best_slot|obs_run_info\",run_id!=\"\"}, net)",
    "definition": "label_values({__name__=~\"up|jam_best_slot|obs_run_info\",run_id!=\"\"}, net)",
    "refresh": 2,
    "sort": 1,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 0
   },
   {
    "name": "run_id",
    "label": "run_id",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values({__name__=~\"up|jam_best_slot|obs_run_info\",net=\"$net\"}, run_id)",
    "definition": "label_values({__name__=~\"up|jam_best_slot|obs_run_info\",net=\"$net\"}, run_id)",
    "refresh": 2,
    "sort": 2,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 0
   },
   {
    "name": "node",
    "label": "node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values({__name__=~\"jam_best_slot|up|obs_container_running\",net=\"$net\",run_id=\"$run_id\"}, node)",
    "definition": "label_values({__name__=~\"jam_best_slot|up|obs_container_running\",net=\"$net\",run_id=\"$run_id\"}, node)",
    "refresh": 2,
    "sort": 1,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 0
   },
   {
    "name": "at",
    "label": "at",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "query_result(clamp_max(max(obs_run_end_timestamp_seconds{net=\"$net\",run_id=\"$run_id\"}), ${__to:date:seconds}) or vector(${__to:date:seconds}))",
    "definition": "query_result(clamp_max(max(obs_run_end_timestamp_seconds{net=\"$net\",run_id=\"$run_id\"}), ${__to:date:seconds}) or vector(${__to:date:seconds}))",
    "regex": "/\\}\\s+(\\S+)\\s/",
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 2
   },
   {
    "name": "run_from",
    "label": "run_from",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "query_result(max by (link_from) (obs_run_info{net=\"$net\",run_id=\"$run_id\"}))",
    "definition": "query_result(max by (link_from) (obs_run_info{net=\"$net\",run_id=\"$run_id\"}))",
    "regex": "/link_from=\"([^\"]+)\"/",
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 2
   },
   {
    "name": "run_to",
    "label": "run_to",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "query_result(max by (link_to) (obs_run_info{net=\"$net\",run_id=\"$run_id\"}))",
    "definition": "query_result(max by (link_to) (obs_run_info{net=\"$net\",run_id=\"$run_id\"}))",
    "regex": "/link_to=\"([^\"]+)\"/",
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 2
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "name": "Annotations & Alerts",
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "type": "dashboard",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    }
   },
   {
    "name": "run events",
    "enable": true,
    "hide": false,
    "iconColor": "#5794F2",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "target": {
     "type": "tags",
     "tags": [
      "$run_id",
      "event"
     ],
     "matchAny": false,
     "limit": 500
    }
   },
   {
    "name": "PASS",
    "enable": true,
    "hide": false,
    "iconColor": "green",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "target": {
     "type": "tags",
     "tags": [
      "$run_id",
      "pass"
     ],
     "matchAny": false,
     "limit": 500
    }
   },
   {
    "name": "FAIL",
    "enable": true,
    "hide": false,
    "iconColor": "red",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "target": {
     "type": "tags",
     "tags": [
      "$run_id",
      "fail"
     ],
     "matchAny": false,
     "limit": 500
    }
   },
   {
    "name": "lifecycle",
    "enable": true,
    "hide": false,
    "iconColor": "#B877D9",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "expr": "{source=\"lifecycle\", net=\"$net\", run_id=\"$run_id\"} | json | event=~\"run_begin|run_end|start|restart|die\" | during_run!=\"true\" or reason!~\"killed|oom|crashed\"",
    "target": {
     "expr": "{source=\"lifecycle\", net=\"$net\", run_id=\"$run_id\"} | json | event=~\"run_begin|run_end|start|restart|die\" | during_run!=\"true\" or reason!~\"killed|oom|crashed\"",
     "refId": "Anno",
     "queryType": "range"
    },
    "instant": false,
    "titleFormat": "{{node}} {{event}}",
    "textFormat": "{{msg}}",
    "tagKeys": "node,event,reason"
   },
   {
    "name": "node stopped during the run",
    "enable": true,
    "hide": false,
    "iconColor": "red",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "expr": "{source=\"lifecycle\", net=\"$net\", run_id=\"$run_id\"} | json | event=\"die\" | during_run=\"true\" | reason=~\"killed|oom|crashed\"",
    "target": {
     "expr": "{source=\"lifecycle\", net=\"$net\", run_id=\"$run_id\"} | json | event=\"die\" | during_run=\"true\" | reason=~\"killed|oom|crashed\"",
     "refId": "Anno",
     "queryType": "range"
    },
    "instant": false,
    "titleFormat": "{{node}} {{event}}",
    "textFormat": "{{msg}}",
    "tagKeys": "node,event,reason"
   }
  ]
 },
 "links": [
  {
   "type": "link",
   "title": "whole run",
   "icon": "dashboard",
   "includeVars": true,
   "keepTime": false,
   "targetBlank": false,
   "tooltip": "Set the time range to this run's start \u2192 end (1 min either side)",
   "url": "/d/obs-node?from=${run_from}&to=${run_to}"
  },
  {
   "type": "dashboards",
   "tags": [
    "obs"
   ],
   "asDropdown": false,
   "includeVars": true,
   "keepTime": true,
   "title": "obs"
  }
 ],
 "panels": [
  {
   "type": "text",
   "title": "",
   "transparent": true,
   "options": {
    "mode": "markdown",
    "content": "**What happened to this node?** Its state and, if it stopped, why (the container's lifecycle: teardown, killed, crashed with an exit code, OOM-killed, or running but stalled), its last words, then its chain, work-packages, resources and every log line. Standard `jam_*` series first; for a lasair node, lasair's own names where a `jam_*` one is missing. Figures are at the range's end or, for a finished run, at its end; **whole run** (top right) shows the run start to end. [All nodes](/d/obs-overview?orgId=1&var-net=${net}&var-run_id=${run_id}&${__url_time_range}) \u00b7 [Logs](/d/obs-logs?orgId=1&var-net=${net}&var-run_id=${run_id}&var-node=${node}&${__url_time_range})"
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   }
  },
  {
   "type": "stat",
   "title": "State",
   "description": "advancing, stopped during the run (its best slot stopped over 60 s before the rest of the net's), or net stalled (no node advancing).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "(max by (node, client) (max_over_time((timestamp(jam_best_slot{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}) and changes(jam_best_slot{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}[1m]) > 0)[$__range:15s] @ $at)) >= bool on() group_left() (max(max by (node, client) (max_over_time((timestamp(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}) and changes(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}[1m]) > 0)[$__range:15s] @ $at))) - 60)) * on() group_left() (1 + (max(max by (node, client) (max_over_time((timestamp(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}) and changes(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}[1m]) > 0)[$__range:15s] @ $at))) < bool ($at - 60)))",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no chain data",
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "stopped during the run",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "advancing",
         "color": "green",
         "index": 1
        },
        "2": {
         "text": "net stalled",
         "color": "#8e8e8e",
         "index": 2
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#8e8e8e",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Why it stopped",
   "description": "The container's last stop in the range, from Docker (the lifecycle service): teardown (the net was shut down), stopped, killed, oom, crashed or exited, and when. Red: killed, OOM-killed or crashed while its run was active. Orange: the container runs but its best slot has not moved for over a minute (hung, or cut off).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max by (reason) (last_over_time(obs_container_stopped_timestamp_seconds{net=\"$net\",run_id=\"$run_id\",node=\"$node\",during_run=\"true\",reason=~\"killed|oom|crashed\"}[$__range])) * 1000",
     "refId": "A",
     "range": false,
     "instant": true,
     "legendFormat": "{{reason}}"
    },
    {
     "expr": "max by (reason) (last_over_time(obs_container_stopped_timestamp_seconds{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}[$__range])) * 1000 unless max by (reason) (last_over_time(obs_container_stopped_timestamp_seconds{net=\"$net\",run_id=\"$run_id\",node=\"$node\",during_run=\"true\",reason=~\"killed|oom|crashed\"}[$__range]))",
     "refId": "B",
     "range": false,
     "instant": true,
     "legendFormat": "{{reason}}"
    },
    {
     "expr": "max(max by (node, client) (max_over_time((timestamp(jam_best_slot{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}) and changes(jam_best_slot{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}[1m]) > 0)[$__range:15s] @ $at))) * 1000 and on() (max(last_over_time(obs_container_running{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}[1m] @ $at)) == 1) and on() (max(max by (node, client) (max_over_time((timestamp(jam_best_slot{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}) and changes(jam_best_slot{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}[1m]) > 0)[$__range:15s] @ $at))) < ($at - 60))",
     "refId": "C",
     "range": false,
     "instant": true,
     "legendFormat": "running, stalled since"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "not stopped",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     },
     "unit": "dateTimeAsLocalNoDateIfToday"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "B"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8e8e8e"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "C"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value_and_name",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 3,
   "gridPos": {
    "x": 4,
    "y": 3,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Exit code",
   "description": "The exit code of its last stop in the range. 137: SIGKILL (docker kill, OOM, a stop that timed out); 143: SIGTERM.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(last_over_time(obs_container_last_exit_code{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}[$__range]))",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "\u2013",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 4,
   "gridPos": {
    "x": 10,
    "y": 3,
    "w": 2,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Restarts",
   "description": "Starts after it had stopped (restart policy, docker restart).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(last_over_time(obs_container_restarts_total{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}[$__range])) or (max(last_over_time(obs_container_running{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}[$__range])) * 0)",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 5,
   "gridPos": {
    "x": 12,
    "y": 3,
    "w": 2,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Last advanced",
   "description": "When its best slot last moved in the range, up to the run's end (to within a minute).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(max by (node, client) (max_over_time((timestamp(jam_best_slot{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}) and changes(jam_best_slot{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}[1m]) > 0)[$__range:15s] @ $at))) * 1000",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     },
     "unit": "dateTimeAsLocalNoDateIfToday"
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 6,
   "gridPos": {
    "x": 14,
    "y": 3,
    "w": 3,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Scraped",
   "description": "up: 1 while Alloy scrapes its /metrics. Nodes seen only through JIP-2 or JIP-3 have no scrape target.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(last_over_time(up{net=\"$net\",run_id=\"$run_id\",node=\"$node\"}[1m] @ $at))",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no scrape target",
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "target down",
         "color": "red"
        },
        "1": {
         "text": "up",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#8e8e8e",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 7,
   "gridPos": {
    "x": 17,
    "y": 3,
    "w": 3,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Last scrape",
   "description": "When Alloy last scraped it.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(max_over_time(timestamp(up{net=\"$net\",run_id=\"$run_id\",node=\"$node\"})[$__range:15s] @ $at)) * 1000",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
