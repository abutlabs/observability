   "id": 8,
   "gridPos": {
    "x": 20,
    "y": 3,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "logs",
   "title": "Lifecycle",
   "description": "The container's Docker events (create, start, kill, oom, stop, die with its exit code and why, destroy), newest first. Expand a line for its fields (event, reason, exit_code, signal, during_run).",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{source=\"lifecycle\", net=\"$net\", run_id=\"$run_id\", node=\"$node\"} | json | line_format `{{.msg}}`",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false,
    "showLabels": false,
    "showCommonLabels": false
   },
   "id": 9,
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 12,
    "h": 9
   }
  },
  {
   "type": "logs",
   "title": "Last words",
   "description": "Its last 20 lines in the range: if it stopped, what it said just before.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{net=\"$net\", run_id=\"$run_id\", node=\"$node\", source!=\"lifecycle\"}",
     "refId": "A",
     "queryType": "range",
     "maxLines": 20
    }
   ],
