 "panels": [
  {
   "type": "text",
   "title": "",
   "transparent": true,
   "options": {
    "mode": "markdown",
    "content": "**Which nodes make up this net, what client runs each, and is every node keeping up?** One row per node, whatever its client. A node's figures come from its own `/metrics` if it serves the standard `jam_*` set, else from the JIP-2 exporter polling its RPC, else from the JIP-3 events it pushes; the *paths* column says how many of those describe it."
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   }
  },
  {
   "type": "stat",
   "title": "Nodes reporting",
   "description": "Nodes with a best block from any path.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "count(max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"}))",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
