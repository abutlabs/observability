{
 "uid": "obs-overview",
 "title": "Network overview",
 "tags": [
  "obs"
 ],
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "templating": {
  "list": [
   {
    "name": "net",
    "label": "net",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values({__name__=~\"up|jam_best_slot|obs_run_info\",run_id!=\"\"}, net)",
    "definition": "label_values({__name__=~\"up|jam_best_slot|obs_run_info\",run_id!=\"\"}, net)",
    "refresh": 2,
    "sort": 1,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 0
   },
   {
    "name": "run_id",
    "label": "run_id",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values({__name__=~\"up|jam_best_slot|obs_run_info\",net=\"$net\"}, run_id)",
    "definition": "label_values({__name__=~\"up|jam_best_slot|obs_run_info\",net=\"$net\"}, run_id)",
    "refresh": 2,
    "sort": 2,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 0
   },
   {
    "name": "at",
    "label": "at",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "query_result(clamp_max(max(obs_run_end_timestamp_seconds{net=\"$net\",run_id=\"$run_id\"}), ${__to:date:seconds}) or vector(${__to:date:seconds}))",
    "definition": "query_result(clamp_max(max(obs_run_end_timestamp_seconds{net=\"$net\",run_id=\"$run_id\"}), ${__to:date:seconds}) or vector(${__to:date:seconds}))",
    "regex": "/\\}\\s+(\\S+)\\s/",
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 2
   },
   {
    "name": "run_from",
    "label": "run_from",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "query_result(max by (link_from) (obs_run_info{net=\"$net\",run_id=\"$run_id\"}))",
    "definition": "query_result(max by (link_from) (obs_run_info{net=\"$net\",run_id=\"$run_id\"}))",
    "regex": "/link_from=\"([^\"]+)\"/",
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 2
   },
   {
    "name": "run_to",
    "label": "run_to",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "query_result(max by (link_to) (obs_run_info{net=\"$net\",run_id=\"$run_id\"}))",
    "definition": "query_result(max by (link_to) (obs_run_info{net=\"$net\",run_id=\"$run_id\"}))",
    "regex": "/link_to=\"([^\"]+)\"/",
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false,
    "current": {},
    "options": [],
    "hide": 2
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "name": "Annotations & Alerts",
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "type": "dashboard",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    }
   },
   {
    "name": "run events",
    "enable": true,
    "hide": false,
    "iconColor": "#5794F2",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "target": {
     "type": "tags",
     "tags": [
      "$run_id",
      "event"
     ],
     "matchAny": false,
     "limit": 500
    }
   },
   {
    "name": "PASS",
    "enable": true,
    "hide": false,
    "iconColor": "green",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "target": {
     "type": "tags",
     "tags": [
      "$run_id",
      "pass"
     ],
     "matchAny": false,
     "limit": 500
    }
   },
   {
    "name": "FAIL",
    "enable": true,
    "hide": false,
    "iconColor": "red",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "target": {
     "type": "tags",
     "tags": [
      "$run_id",
      "fail"
     ],
     "matchAny": false,
     "limit": 500
    }
   },
   {
    "name": "lifecycle",
    "enable": true,
    "hide": false,
    "iconColor": "#B877D9",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "expr": "{source=\"lifecycle\", net=\"$net\", run_id=\"$run_id\"} | json | event=~\"run_begin|run_end|start|restart|die\" | during_run!=\"true\" or reason!~\"killed|oom|crashed\"",
    "target": {
     "expr": "{source=\"lifecycle\", net=\"$net\", run_id=\"$run_id\"} | json | event=~\"run_begin|run_end|start|restart|die\" | during_run!=\"true\" or reason!~\"killed|oom|crashed\"",
     "refId": "Anno",
     "queryType": "range"
    },
    "instant": false,
    "titleFormat": "{{node}} {{event}}",
    "textFormat": "{{msg}}",
    "tagKeys": "node,event,reason"
   },
   {
    "name": "node stopped during the run",
    "enable": true,
    "hide": false,
    "iconColor": "red",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "expr": "{source=\"lifecycle\", net=\"$net\", run_id=\"$run_id\"} | json | event=\"die\" | during_run=\"true\" | reason=~\"killed|oom|crashed\"",
    "target": {
     "expr": "{source=\"lifecycle\", net=\"$net\", run_id=\"$run_id\"} | json | event=\"die\" | during_run=\"true\" | reason=~\"killed|oom|crashed\"",
     "refId": "Anno",
     "queryType": "range"
    },
    "instant": false,
    "titleFormat": "{{node}} {{event}}",
    "textFormat": "{{msg}}",
    "tagKeys": "node,event,reason"
   }
  ]
 },
 "links": [
  {
   "type": "link",
   "title": "whole run",
   "icon": "dashboard",
   "includeVars": true,
   "keepTime": false,
   "targetBlank": false,
   "tooltip": "Set the time range to this run's start \u2192 end (1 min either side)",
   "url": "/d/obs-overview?from=${run_from}&to=${run_to}"
  },
  {
   "type": "dashboards",
   "tags": [
    "obs"
   ],
   "asDropdown": false,
   "includeVars": true,
   "keepTime": true,
   "title": "obs"
  }
 ],
 "panels": [
  {
   "type": "text",
   "title": "",
   "transparent": true,
   "options": {
    "mode": "markdown",
    "content": "**Which nodes make up this net, what client runs each, and is every node keeping up?** One row per node, whatever its client. A node's figures come from its own `/metrics` if it serves the standard `jam_*` set, else from the JIP-2 exporter polling its RPC, else from the JIP-3 events it pushes; the *paths* column says how many of those describe it."
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   }
  },
  {
   "type": "stat",
   "title": "Run",
   "description": "The run's state from its record (obs begin, obs end): active, ended normally (grey) or active with no node advancing for over 60 s (red). A net run without the obs CLI has no record. Click for the whole run.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(obs_run_end_timestamp_seconds{net=\"$net\",run_id=\"$run_id\"}) * 1000",
     "refId": "A",
     "range": false,
     "instant": true
    },
    {
     "expr": "max(obs_run_start_timestamp_seconds{net=\"$net\",run_id=\"$run_id\"}) * 1000 unless on() max(obs_run_end_timestamp_seconds{net=\"$net\",run_id=\"$run_id\"}) unless on() (max(max by (node, client) (max_over_time((timestamp(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}) and changes(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}[1m]) > 0)[$__range:15s] @ $at))) < ($at - 60))",
     "refId": "B",
     "range": false,
     "instant": true
    },
    {
     "expr": "(max(max by (node, client) (max_over_time((timestamp(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}) and changes(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}[1m]) > 0)[$__range:15s] @ $at))) < ($at - 60)) * 1000 unless on() max(obs_run_end_timestamp_seconds{net=\"$net\",run_id=\"$run_id\"}) and on() max(obs_run_start_timestamp_seconds{net=\"$net\",run_id=\"$run_id\"})",
     "refId": "C",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no run record",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     },
     "links": [
      {
       "title": "Show the whole run",
       "url": "/d/${__dashboard.uid}?orgId=1&var-net=${net}&var-run_id=${run_id}&from=${run_from}&to=${run_to}"
      }
     ]
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "unit",
        "value": "time:[run ended ]HH:mm:ss[ \u2014 net shut down]"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "B"
      },
      "properties": [
       {
        "id": "unit",
        "value": "time:[run active since ]HH:mm:ss"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#5794F2"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "C"
      },
      "properties": [
       {
        "id": "unit",
        "value": "time:[net stalled since ]HH:mm:ss[ \u2014 run not ended]"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Nodes advancing",
   "description": "Nodes whose best slot moved within 60 s of the net's newest move, at the range's end or, for a finished run, at its end.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "count(max by (node, client) (max_over_time((timestamp(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}) and changes(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}[1m]) > 0)[$__range:15s] @ $at)) >= on() group_left() (max(max by (node, client) (max_over_time((timestamp(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}) and changes(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}[1m]) > 0)[$__range:15s] @ $at))) - 60))",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 3,
   "gridPos": {
    "x": 6,
    "y": 3,
    "w": 3,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Clients",
   "description": "Distinct client implementations among them.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "last_over_time((count(count by (client) (max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"}))))[$__range:$__interval] @ $at)",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 4,
   "gridPos": {
    "x": 9,
    "y": 3,
    "w": 3,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Newest best slot",
   "description": "The highest best slot any node reports.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "last_over_time((max(max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"})))[$__range:$__interval] @ $at)",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 5,
   "gridPos": {
    "x": 12,
    "y": 3,
    "w": 3,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Newest finalized slot",
   "description": "The highest finalized slot.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "last_over_time((max(max by (node, client) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"})))[$__range:$__interval] @ $at)",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 6,
   "gridPos": {
    "x": 15,
    "y": 3,
    "w": 3,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Head spread \u00b7 PASS \u2264 3 slots",
   "description": "Newest best slot minus the oldest: how far the slowest node is behind.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "last_over_time((max(max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"})) - min(max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"})))[$__range:$__interval] @ $at)",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 3.000000001
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 7,
   "gridPos": {
    "x": 18,
    "y": 3,
    "w": 3,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Nodes stopped during the run \u00b7 PASS = 0",
   "description": "Nodes whose best slot stopped advancing more than 60 s before the rest of the net's did, within the range (up to the run's end). A net shut down at the end of its run stops all together and is not counted.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "count(max by (node, client) (max_over_time((timestamp(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}) and changes(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}[1m]) > 0)[$__range:15s] @ $at)) < on() group_left() (max(max by (node, client) (max_over_time((timestamp(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}) and changes(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}[1m]) > 0)[$__range:15s] @ $at))) - 60)) or (max(max by (node, client) (max_over_time((timestamp(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}) and changes(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}[1m]) > 0)[$__range:15s] @ $at))) * 0)",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1e-09
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 8,
   "gridPos": {
    "x": 21,
    "y": 3,
    "w": 3,
    "h": 4
   }
  },
  {
   "type": "table",
   "title": "Nodes",
   "description": "One row per node, at the range's end or, for a finished run, at its end. state: advancing, stopped during the run (its best slot stopped over 60 s before the rest of the net's), or net stalled. last advanced: when its best slot last moved (to within a minute). stopped and why: the container's last stop in the range (the lifecycle service). Click a node for Node detail, or for its last minutes of logs.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "last_over_time((max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"}))[$__range:$__interval] @ $at)",
     "refId": "A",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "last_over_time((max by (node, client) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"}))[$__range:$__interval] @ $at)",
     "refId": "B",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "last_over_time((max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"}) - (max by (node, client) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"}) > 0))[$__range:$__interval] @ $at)",
     "refId": "C",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "last_over_time((sum by (node, client) (max by (node, client, role) (jam_peers{net=\"$net\",run_id=\"$run_id\"})))[$__range:$__interval] @ $at)",
     "refId": "D",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "last_over_time((max by (node, client, client_version, gp_version) (jam_node_info{net=\"$net\",run_id=\"$run_id\",client_version!=\"\"}))[$__range:$__interval] @ $at)",
     "refId": "E",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "last_over_time((count by (node, client) (group by (node, client, source) (label_replace(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}, \"source\", \"metrics\", \"source\", \"\"))))[$__range:$__interval] @ $at)",
     "refId": "F",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
