   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"})",
     "refId": "A",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "max by (node, client) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"})",
     "refId": "B",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "max by (node, client) (jam_best_slot{net=\"$net\",run_id=\"$run_id\"}) - (max by (node, client) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"}) > 0)",
     "refId": "C",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "sum by (node, client) (max by (node, client, role) (jam_peers{net=\"$net\",run_id=\"$run_id\"}))",
     "refId": "D",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "max by (node, client, client_version, gp_version) (jam_node_info{net=\"$net\",run_id=\"$run_id\",client_version!=\"\"})",
     "refId": "E",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "count by (node, client) (group by (node, client, source) (label_replace(jam_best_slot{net=\"$net\",run_id=\"$run_id\"}, \"source\", \"metrics\", \"source\", \"\")))",
     "refId": "F",
     "format": "table",
     "instant": true,
     "range": false
    }
   ],
