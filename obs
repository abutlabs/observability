#!/usr/bin/env python3
"""obs: run the observability stack, and report runs of JAM networks into it.

The stack
    obs up                        start (or update) it; print its URLs and dashboard folders
    obs down [--wipe]             stop it (the data is kept unless --wipe)
    obs status [-v]               each service, the runs reporting now (-v: every target)
    obs ping                      exit 0 iff Prometheus, Grafana and Alloy answer
    obs url NAME                  a service's URL: grafana prometheus loki pushgateway
                                  alloy jip3

Runs (a run id names one life of a net: every series, log line and annotation carries it)
    obs new-run NET               print a fresh run id, NET-<UTC yyyymmddTHHMMSSZ>
    obs begin NET [--run-id ID] [--meta k=v]...
                                  record the start of NET's run (ending its previous one)
                                  and print the run id; a Docker net then passes it to
                                  its containers' org.abutlabs.obs.run_id label
    obs end NET                   record the end of NET's run; drop its file targets
    obs current NET               NET's run id (exit 1 if none)
    obs runs [--net NET] [--json] the recorded runs, newest first

Processes on this machine (no container labels to discover them by)
    obs register NET RUN_ID JOB TARGET... [--label k=v]... [--jip2 | --jip3]
        TARGET = [node@]host:port[/path]; node defaults to the host, path to /metrics,
        client to JOB. Default: a Prometheus endpoint Alloy scrapes. --jip2: a JIP-2 RPC
        the JIP-2 exporter polls. --jip3: a node's JAMNP-S address, so the JIP-3 receiver
        labels its telemetry connection. A container reaches this machine at
        host.docker.internal. A new RUN_ID for NET drops NET's old targets.
    obs unregister NET            the same as `obs end NET`

Grafana
    obs annotate RUN_ID TEXT [--tags a,b] [--start T] [--end T]
        an annotation tagged with the run id and its net: a point at --start (default
        now), a region to --end. T = now | start | unix seconds | unix ms. Tags pass and
        fail draw it green or red; anything else marks a run event.
    obs link RUN_ID [-d DASHBOARD] [--all]
        the dashboard URL with the run's variables and time range. DASHBOARD is a uid,
        with or without its obs- prefix (chain, overview, soak-runs, ...); --all lists
        every dashboard with a run selector.

Batch results
    obs push JOB [--group k=v]... [FILE]
        push Prometheus text (FILE, default stdin) to the Pushgateway, grouped by job and
        the --group labels (e.g. run_id, net); same-named metrics in the group are replaced

Configuration (environment): OBS_STATE (~/.cache/abutlabs-obs: targets, runs),
OBS_PROJECT (compose project, obs), OBS_BIND (127.0.0.1), ports OBS_GRAFANA_PORT (3300),
OBS_PROMETHEUS_PORT (9390), OBS_LOKI_PORT (3100), OBS_PUSHGATEWAY_PORT (9091),
OBS_ALLOY_PORT (12345), OBS_JIP3_PORT (9910), OBS_GRAFANA_PASSWORD (obs, set before the
first up). Dashboard folders: every sibling of this checkout with
observability/dashboards/ is a folder named after it; <NAME>_DIR (e.g. LASAIR_DIR) points
NAME at another checkout; OBS_PROJECT_DIRS adds more (colon-separated). Stdlib only.
"""
import argparse
import base64
import glob
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HOME = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HOME, "lib"))
import obslib  # noqa: E402  (the run range, shared with the lifecycle service)

STATE = os.environ.get("OBS_STATE") or os.path.expanduser("~/.cache/abutlabs-obs")
PROJECT = os.environ.get("OBS_PROJECT", "obs")
HOST = os.environ.get("OBS_HOST", "localhost")
PORTS = {"grafana": ("OBS_GRAFANA_PORT", 3300), "prometheus": ("OBS_PROMETHEUS_PORT", 9390),
         "loki": ("OBS_LOKI_PORT", 3100), "pushgateway": ("OBS_PUSHGATEWAY_PORT", 9091),
         "alloy": ("OBS_ALLOY_PORT", 12345), "jip3": ("OBS_JIP3_PORT", 9910)}
READY = {"prometheus": "/-/ready", "grafana": "/api/health", "alloy": "/-/ready",
         "loki": "/ready", "pushgateway": "/-/ready"}
GRAFANA_AUTH = ("admin", os.environ.get("OBS_GRAFANA_PASSWORD", "obs"))
PLATFORM = "platform"
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:-]*$")
TARGET = re.compile(r"^(?:(?P<node>[A-Za-z0-9_.:-]+)@)?(?P<host>[A-Za-z0-9_.-]+):(?P<port>\d+)"
                    r"(?P<path>/\S*)?$")
RESERVED = ("net", "run_id", "job", "node")


def url(name):
    """A service's URL on this machine (jip3: host:port, what --telemetry takes)."""
    env, port = PORTS[name]
    return ("%s:%s" if name == "jip3" else "http://%s:%s") % (HOST, os.environ.get(env) or port)


def die(msg, code=2):
    print("obs: " + msg, file=sys.stderr)
    sys.exit(code)


def check_name(kind, v):
    if not NAME.match(v or ""):
        die("bad %s %r: letters, digits and _ . : - only" % (kind, v))
    return v


# ---- state ---------------------------------------------------------------------------
def _path(*parts):
    return os.path.join(STATE, *parts)


def _read(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def _write(path, obj, raw=False):
    """Atomically: collectors re-read a target file the moment it changes."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        if raw:
            fh.write(obj)
        else:
            json.dump(obj, fh, indent=1)
            fh.write("\n")
    os.replace(tmp, path)


TARGET_DIRS = {"scrape": "", "jip2": "jip2", "jip3": "jip3"}


def net_file(net):
    return _path("nets", net + ".json")


def run_file(run_id):
    return _path("runs", run_id + ".json")


def target_files(net):
    out = []
    for sub in TARGET_DIRS.values():
        out += glob.glob(os.path.join(_path("targets", sub), glob.escape(net) + "--*.json"))
    return sorted(out)


def parse_target(spec):
    m = TARGET.match(spec)
    if not m:
        die("bad target %r: want [node@]host:port[/path]" % spec)
    return {"node": m["node"] or m["host"], "addr": "%s:%s" % (m["host"], m["port"]),
            "path": m["path"] or "/metrics"}


def file_sd(net, run_id, job, targets, labels):
    """One file_sd group per target: each carries its own node label."""
    groups = []
    for t in targets:
        lb = {"net": net, "run_id": run_id, "job": job, "node": t["node"], "client": job}
        lb.update(labels)
        if t["path"] != "/metrics":
            lb["__metrics_path__"] = t["path"]
        groups.append({"targets": [t["addr"]], "labels": lb})
    return groups


# ---- dashboard folders ---------------------------------------------------------------
def projects():
    """{folder name: dashboards directory} for every project that has dashboards."""
    roots = {}
    parent = os.path.dirname(HOME)
    for d in sorted(os.listdir(parent)) if os.path.isdir(parent) else []:
        if os.path.join(parent, d) != HOME and os.path.isdir(os.path.join(parent, d)):
            roots[d] = os.path.join(parent, d)
    for p in filter(None, os.environ.get("OBS_PROJECT_DIRS", "").split(":")):
        roots[os.path.basename(os.path.normpath(p))] = p
    for k, v in os.environ.items():
        m = re.match(r"^([A-Z][A-Z0-9_]*)_DIR$", k)
        if m:
            name = m.group(1).lower()
            if name in roots or os.path.isdir(os.path.join(v, "observability", "dashboards")):
                roots[name] = v
    out = {}
    for name, root in sorted(roots.items()):
        d = os.path.join(os.path.abspath(os.path.expanduser(root)), "observability", "dashboards")
        if name != PLATFORM and NAME.match(name) and os.path.isdir(d):
            out[name] = d
    return out


def provider(name, path):
    return ("  - name: %s\n    folder: %s\n    folderUid: obs-folder-%s\n    type: file\n"
            "    disableDeletion: true\n    allowUiUpdates: false\n    updateIntervalSeconds: 10\n"
            "    options:\n      path: %s\n" % (name, name, name, path))


def write_generated(projs):
    """The Grafana providers and the compose override that mounts each project's folder."""
    prov = ["# generated by ./obs up: one dashboard folder per owner\napiVersion: 1\nproviders:\n",
            provider(PLATFORM, "/etc/grafana/dashboards/" + PLATFORM)]
    vols = []
    for name, d in sorted(projs.items()):
        prov.append(provider(name, "/etc/grafana/dashboards/" + name))
        vols.append("      - {type: bind, source: %s, target: /etc/grafana/dashboards/%s, read_only: true}\n"
                    % (json.dumps(d), name))
    _write(_path("grafana", "providers.yml"), "".join(prov), raw=True)
    override = "# generated by ./obs up: each project's dashboards folder\nservices:\n  grafana:\n"
    override += ("    volumes:\n" + "".join(vols)) if vols else "    volumes: []\n"
    _write(_path("compose.projects.yml"), override, raw=True)


def compose(*args):
    projs = projects()
    write_generated(projs)
    for sub in TARGET_DIRS.values():
        os.makedirs(_path("targets", sub), exist_ok=True)
    os.makedirs(_path("runs"), exist_ok=True)
    env = dict(os.environ, OBS_PROJECT=PROJECT, OBS_TARGETS=_path("targets"), OBS_RUNS=_path("runs"),
               OBS_GRAFANA_PROVIDERS=_path("grafana"))
    cmd = ["docker", "compose", "-p", PROJECT, "-f", os.path.join(HOME, "compose.yml"),
           "-f", _path("compose.projects.yml")] + list(args)
    return subprocess.run(cmd, env=env).returncode, projs


def dashboards():
    """[(uid, title, folder)] of every dashboard with a run_id variable."""
    out = []
    dirs = [(PLATFORM, os.path.join(HOME, "dashboards"))] + sorted(projects().items())
    for folder, d in dirs:
        for f in sorted(glob.glob(os.path.join(d, "*.json"))):
            j = _read(f) or {}
            names = [v.get("name") for v in (j.get("templating") or {}).get("list", [])]
            if j.get("uid") and "run_id" in names:
                out.append((j["uid"], j.get("title", j["uid"]), folder))
    return out


# ---- HTTP ------------------------------------------------------------------------------
def http(method, u, body=None, auth=None, timeout=5, raw=None, ctype="application/json"):
    data = raw if raw is not None else (None if body is None else json.dumps(body).encode())
    req = urllib.request.Request(u, method=method, data=data)
    req.add_header("Content-Type", ctype)
    if auth:
        req.add_header("Authorization", "Basic " + base64.b64encode(("%s:%s" % auth).encode()).decode())
    with urllib.request.urlopen(req, timeout=timeout) as r:
        out = r.read()
    return json.loads(out) if out.strip().startswith((b"{", b"[")) else out.decode()


def ready(name, timeout=2):
    try:
        http("GET", url(name) + READY[name], timeout=timeout)
        return True
    except (OSError, ValueError):
        return False


def query(expr):
    q = urllib.parse.urlencode({"query": expr})
    return http("GET", url("prometheus") + "/api/v1/query?" + q)["data"]["result"]


# ---- commands: the stack ---------------------------------------------------------------
def cmd_up(a):
    rc, projs = compose("up", "-d", "--remove-orphans")
    if rc:
        return rc
    deadline = time.time() + 180
    while not all(ready(n) for n in READY):
        if time.time() > deadline:
            down = [n for n in READY if not ready(n)]
            die("started, but %s do not answer: docker compose -p %s logs %s"
                % (", ".join(down), PROJECT, " ".join(down)), 1)
        time.sleep(1)
    for n in ("grafana", "prometheus", "loki", "pushgateway", "alloy"):
        print("%-12s %s" % (n, url(n)))
    print("%-12s %s  (--telemetry; containers on an observed net: obs-jip3:9910)" % ("jip3", url("jip3")))
    print("dashboards   %s" % ", ".join([PLATFORM] + ["%s (%s)" % kv for kv in sorted(projs.items())]))
    return 0


def cmd_down(a):
    return compose("down", *(["-v"] if a.wipe else []))[0]


def cmd_ping(a):
    return 0 if all(ready(n) for n in ("prometheus", "grafana", "alloy")) else 1


def cmd_url(a):
    print(url(a.name))
    return 0


def cmd_status(a):
    for n in ("grafana", "prometheus", "loki", "pushgateway", "alloy"):
        print("%-12s %-28s %s" % (n, url(n), "up" if ready(n) else "DOWN"))
    if not ready("prometheus"):
        return 1
    try:
        up = query('up{run_id!=""}')
        derived = query('count by (net, run_id, source) (jam_best_slot{source=~"jip2|jip3"})')
        joined = query("obs_netjoin_networks")
    except (OSError, ValueError, KeyError) as e:
        print("Prometheus query failed: %s" % e)
        return 1
    runs = {}
    for s in up:
        m = s["metric"]
        key = (m.get("net", "?"), m.get("run_id", "?"))
        jobs = runs.setdefault(key, {})
        u, n = jobs.get(m.get("job", "?"), (0, 0))
        jobs[m.get("job", "?")] = (u + (s["value"][1] == "1"), n + 1)
    for s in derived:
        m = s["metric"]
        runs.setdefault((m.get("net", "?"), m.get("run_id", "?")), {})["%s nodes" % m["source"]] = (
            int(float(s["value"][1])), None)
    if not runs:
        print("no run is reporting")
    for (net, run_id), jobs in sorted(runs.items()):
        print("%-14s %-32s %s" % (net, run_id, "  ".join(
            ("%s %d" % (j, u)) if n is None else ("%s %d/%d up" % (j, u, n))
            for j, (u, n) in sorted(jobs.items()))))
    if joined:
        print("netjoin      %s" % ", ".join("%s on %s network(s)" % (s["metric"].get("service"),
                                                                    s["value"][1]) for s in joined))
    if a.verbose:
        for s in sorted(up, key=lambda s: [s["metric"].get(k, "") for k in ("net", "job", "node")]):
            m = s["metric"]
            print("    %-12s %-10s %-10s %-9s %-4s %s" % (m.get("net"), m.get("job"), m.get("node"),
                                                        m.get("client", ""),
                                                        "up" if s["value"][1] == "1" else "DOWN",
                                                        m.get("instance", "")))
    return 0


# ---- commands: runs --------------------------------------------------------------------
def new_run_id(net):
    return "%s-%s" % (check_name("net", net), time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()))


def cmd_new_run(a):
    print(new_run_id(a.net))
    return 0


def _end_run(run_id):
    rec = _read(run_file(run_id))
    if rec and not rec.get("end"):
        rec["end"] = time.time()
        _write(run_file(run_id), rec)


def begin(net, run_id, kind, meta=None):
    """Make run_id the net's current run: a different previous run ends and its targets go."""
    rec = _read(net_file(net)) or {}
    if rec.get("run_id") and rec["run_id"] != run_id:
        for f in target_files(net):
            os.remove(f)
        _end_run(rec["run_id"])
        rec = {}
    if not os.path.exists(run_file(run_id)):
        _write(run_file(run_id), {"run_id": run_id, "net": net, "kind": kind, "start": time.time(),
                                  "end": None, "meta": meta or {}})
    _write(net_file(net), {"net": net, "run_id": run_id, "kind": kind,
                           "since": rec.get("since") or time.time()})


def _kv(pairs, what):
    out = {}
    for kv in pairs or []:
        k, sep, v = kv.partition("=")
        if not sep or not re.match(r"^[a-zA-Z_][a-zA-Z0-9_]*$", k):
            die("bad %s %r: want k=v" % (what, kv))
        out[k] = v
    return out


def cmd_begin(a):
    net = check_name("net", a.net)
    run_id = check_name("run_id", a.run_id) if a.run_id else new_run_id(net)
    begin(net, run_id, "docker", _kv(a.meta, "--meta"))
    print(run_id)
    return 0


def cmd_end(a):
    net = check_name("net", a.net)
    rec = _read(net_file(net))
    for f in target_files(net):
        os.remove(f)
    if not rec:
        return 0
    if rec.get("run_id"):
        _end_run(rec["run_id"])
    os.remove(net_file(net))
    if a.verbose:
        print("obs: %s ended (run %s)" % (net, rec.get("run_id")))
    return 0


def cmd_current(a):
    rec = _read(net_file(check_name("net", a.net)))
    if not rec or not rec.get("run_id"):
        return 1
    print(rec["run_id"])
    return 0


def all_runs(net=None):
    runs = [r for r in (_read(f) for f in glob.glob(_path("runs", "*.json"))) if r]
    return sorted((r for r in runs if not net or r.get("net") == net),
                  key=lambda r: r.get("start") or 0, reverse=True)


def cmd_runs(a):
    runs = all_runs(a.net)[:a.limit]
    if a.json:
        print(json.dumps(runs, indent=1))
        return 0
    for r in runs:
        t = lambda x: time.strftime("%Y-%m-%d %H:%M", time.gmtime(x)) if x else "running"  # noqa: E731
        print("%-34s %-12s %s -> %s" % (r["run_id"], r.get("net"), t(r.get("start")), t(r.get("end"))))
    return 0


def cmd_register(a):
    net, run_id, job = check_name("net", a.net), check_name("run_id", a.run_id), check_name("job", a.job)
    labels = _kv(a.label, "--label")
    for k in labels:
        if k in RESERVED:
            die("--label %s is set by register itself" % k)
    targets = [parse_target(t) for t in a.targets]
    kind = "jip2" if a.jip2 else ("jip3" if a.jip3 else "scrape")
    begin(net, run_id, "native")
    _write(os.path.join(_path("targets", TARGET_DIRS[kind]), "%s--%s.json" % (net, job)),
           file_sd(net, run_id, job, targets, labels))
    if a.verbose:
        print("obs: %s %s: %s %s (%s)" % (net, run_id, job, " ".join(t["node"] for t in targets), kind))
    return 0


# ---- commands: Grafana -----------------------------------------------------------------
def _run(run_id):
    """The run's record; for a run this machine never recorded, its net from its series."""
    rec = _read(run_file(run_id))
    if rec:
        return rec
    try:
        s = query('group by (net) ({run_id="%s"})' % run_id)
        if s:
            return {"run_id": run_id, "net": s[0]["metric"].get("net"), "start": None, "end": None}
    except (OSError, ValueError, KeyError):
        pass
    return {"run_id": run_id, "net": None, "start": None, "end": None}


def _ms(v, run):
    if v in (None, "now"):
        return int(time.time() * 1000)
    if v == "start":
        if not run.get("start"):
            die("run %s has no recorded start" % run["run_id"])
        return int(run["start"] * 1000)
    try:
        x = float(v)
    except ValueError:
        die("bad time %r: now | start | unix seconds | unix ms" % v)
    return int(x if x > 1e11 else x * 1000)


def cmd_annotate(a):
    run = _run(check_name("run_id", a.run_id))
    extra = [t.strip() for t in (a.tags or "").split(",") if t.strip()]
    tags = ["obs", a.run_id] + ([run["net"]] if run.get("net") else []) + extra
    if not {"pass", "fail"} & set(extra):
        tags.append("event")
    body = {"time": _ms(a.start, run), "tags": tags, "text": a.text}
    if a.end:
        body["timeEnd"] = _ms(a.end, run)
    try:
        r = http("POST", url("grafana") + "/api/annotations", body, auth=GRAFANA_AUTH)
    except urllib.error.HTTPError as e:
        die("Grafana refused the annotation: %s %s" % (e.code, e.read().decode()[:200]), 1)
    except OSError as e:
        die("Grafana unreachable at %s: %s" % (url("grafana"), e), 1)
    if a.verbose:
        print("annotation %s: %s" % (r.get("id"), a.text))
    return 0


def link(run_id, uid):
    run = _run(run_id)
    q = {"orgId": "1", "var-run_id": run_id}
    if run.get("net"):
        q["var-net"] = run["net"]
    rng = obslib.run_range(run)
    if rng:
        q["from"], q["to"] = str(rng[0]), str(rng[1])
        if rng[1] == "now":
            q["refresh"] = "10s"
    else:
        q["from"], q["to"] = "now-6h", "now"
    return "%s/d/%s?%s" % (url("grafana"), uid, urllib.parse.urlencode(q))


def cmd_link(a):
    check_name("run_id", a.run_id)
    known = dashboards()
    if a.all:
        for uid, title, folder in known:
            print("%-26s %s" % ("%s/%s" % (folder, title), link(a.run_id, uid)))
        return 0
    uids = {uid: uid for uid, _, _ in known}
    uids.update({uid[4:]: uid for uid in list(uids) if uid.startswith("obs-")})
    uid = uids.get(a.dashboard) or (a.dashboard if a.dashboard.startswith("obs-") else "obs-" + a.dashboard)
    print(link(a.run_id, uid))
    return 0


# ---- commands: batch results -----------------------------------------------------------
def cmd_push(a):
    job = check_name("job", a.job)
    path = "/metrics/job/" + urllib.parse.quote(job, safe="")
    for k, v in _kv(a.group, "--group").items():
        if not v:
            die("--group %s is empty" % k)
        path += "/%s/%s" % (k, urllib.parse.quote(v, safe=""))
    text = (open(a.file).read() if a.file and a.file != "-" else sys.stdin.read())
    if not text.endswith("\n"):
        text += "\n"
    try:
        http("POST", url("pushgateway") + path, raw=text.encode(), ctype="text/plain; version=0.0.4",
             timeout=10)
    except urllib.error.HTTPError as e:
        die("Pushgateway refused: %s %s" % (e.code, e.read().decode()[:300]), 1)
    except OSError as e:
        die("Pushgateway unreachable at %s: %s" % (url("pushgateway"), e), 1)
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="obs", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=__doc__.split("\n\n", 1)[1])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("up").set_defaults(fn=cmd_up)
    p = sub.add_parser("down")
    p.add_argument("--wipe", action="store_true", help="also delete the data volumes")
    p.set_defaults(fn=cmd_down)
    p = sub.add_parser("status")
    p.add_argument("-v", "--verbose", action="store_true")
    p.set_defaults(fn=cmd_status)
    sub.add_parser("ping").set_defaults(fn=cmd_ping)
    p = sub.add_parser("url")
    p.add_argument("name", choices=sorted(PORTS))
    p.set_defaults(fn=cmd_url)
    p = sub.add_parser("new-run")
    p.add_argument("net")
    p.set_defaults(fn=cmd_new_run)
    p = sub.add_parser("begin")
    p.add_argument("net")
    p.add_argument("--run-id")
    p.add_argument("--meta", action="append")
    p.set_defaults(fn=cmd_begin)
    for name in ("end", "unregister"):
        p = sub.add_parser(name)
        p.add_argument("net")
        p.add_argument("-v", "--verbose", action="store_true")
        p.set_defaults(fn=cmd_end)
    p = sub.add_parser("current")
    p.add_argument("net")
    p.set_defaults(fn=cmd_current)
    p = sub.add_parser("runs")
    p.add_argument("--net")
    p.add_argument("--json", action="store_true")
    p.add_argument("--limit", type=int, default=50)
    p.set_defaults(fn=cmd_runs)
    p = sub.add_parser("register")
    p.add_argument("net")
    p.add_argument("run_id")
    p.add_argument("job")
    p.add_argument("targets", nargs="+")
    p.add_argument("--label", action="append")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--jip2", action="store_true", help="JIP-2 RPC endpoints (the JIP-2 exporter polls them)")
    g.add_argument("--jip3", action="store_true", help="JAMNP-S addresses of JIP-3 senders")
    p.add_argument("-v", "--verbose", action="store_true")
    p.set_defaults(fn=cmd_register)
    p = sub.add_parser("annotate")
    p.add_argument("run_id")
    p.add_argument("text")
    p.add_argument("--tags", default="")
    p.add_argument("--start")
    p.add_argument("--end")
    p.add_argument("-v", "--verbose", action="store_true")
    p.set_defaults(fn=cmd_annotate)
    p = sub.add_parser("link")
    p.add_argument("run_id")
    p.add_argument("--dashboard", "-d", default="chain")
    p.add_argument("--all", action="store_true", help="every dashboard with a run selector")
    p.set_defaults(fn=cmd_link)
    p = sub.add_parser("push")
    p.add_argument("job")
    p.add_argument("file", nargs="?")
    p.add_argument("--group", action="append")
    p.set_defaults(fn=cmd_push)
    a = ap.parse_args(argv)
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
